{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "commonjs",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "paths": {
      "string_decoder": [
        "./node_modules/@types/node/string_decoder.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "tools/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.js",
    "src/vendor-deadline.js"
  ]
}
