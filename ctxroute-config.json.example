{
  "$schema": "./ctxroute-config.schema.json",
  "enabled": true,
  "showNotification": true,
  "mode": "smart",
  "defaultThreshold": 4,
  "frames": 12,
  "http": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "filterMode": "none",
  "filterList": [],
  "servers": {},
  "skills": {
    "my-project": {
      "match": [
        "my-project"
      ],
      "mode": "once",
      "keys": {
        "match": [
          "-command",
          "-commandPaths"
        ]
      }
    }
  },
  "skillsWithoutPerimeter": [
    "example-on-demand-skill"
  ]
}
