# ═══════════════════════════════════════════════════════════════════════
# systemd USER SOCKET for the ctxroute HTTP injection gate.
# NOT INSTALLED. Copy to ~/.config/systemd/user/ctxroute-http.socket,
# next to ctxroute-http.service, then: systemctl --user enable --now
# ctxroute-http.socket   (the SOCKET is what gets enabled, never the service)
# ═══════════════════════════════════════════════════════════════════════
#
# 🔴 WHY THIS FILE EXISTS — it repairs a SELF-INFLICTED OUTAGE, not a hypothesis.
#    The daemon exits 90 the moment its own code changes on disk. That is what
#    an agent WORKING on this repository causes: a refactor is ten edits in two
#    minutes, hence ten exits. Without this file the service is restarted eagerly
#    and, in every window between death and rebirth, NOTHING IS LISTENING — so
#    every other agent's injection is lost IN SILENCE (measured: with no daemon
#    the tool simply runs, no error surfaces, the agent never learns it acted
#    without its knowledge). And a long enough burst hits the start limit, where
#    systemd deliberately stops restarting: the whole fleet loses the lane.
#
# ✅ WHEN SYSTEMD OWNS THE SOCKET, THAT WINDOW CANNOT EXIST. The listening socket
#    is created here, by systemd, and it stays open across every death of the
#    service. Connections arriving while no instance runs QUEUE in the kernel
#    backlog instead of being refused, and the arrival of one is what starts the
#    next instance. Stale code becomes impossible by construction — every
#    instance is born after the change — and there is no restart loop left to
#    rate-limit.
#
# 📐 Everything below comes from systemd.socket(5), systemd 261~rc1, page dated
#    2026-05-24 (read 2026-08-20). Nothing here is folklore.
# ═══════════════════════════════════════════════════════════════════════

[Unit]
Description=ctxroute HTTP injection gate socket (local loopback, user scope)

[Socket]
# ⚠️ LOOPBACK. `http-server.js` does not CHOOSE this address when it is activated:
#    systemd binds it and hands over an already-bound socket. That much is
#    unchanged and it is why the address has to appear in this file at all.
# 🔴 BUT "THE SINGLE PLACE IT IS WRITTEN ON LINUX" WAS ALREADY FALSE, AND THE
#    CORRECTION IS DATED 2026-09-19. The configuration holds the same address —
#    `tools/wiring-generate.js` builds the harness URL from it — so this file and
#    the configuration were TWO places for one value, agreeing by convention and
#    compared by nothing. The failure that left open is SILENT: a configuration on
#    9000 against a unit on 8787 makes systemd hold 8787 while every hook POSTs to
#    9000, and nothing anywhere reports it.
# ✅ SO THE DIRECTION IS NOW WRITTEN DOWN: the CONFIGURATION is the source, this
#    unit is DERIVED from it at install time by `service/render-units.js`, and the
#    shipped copy below is simply that renderer's output for the default
#    configuration — proven byte-for-byte by `test/render-units-pure.test.js`.
# ⚠️ EDITING THE ADDRESS HERE BY HAND IS THEREFORE OVERWRITTEN AT THE NEXT INSTALL.
#    Change `http.host` / `http.port` in the configuration instead, and re-run the
#    installer — that is the gesture that keeps the supervisor and the harness on
#    one number.
# 🛑 Never widen this to 0.0.0.0. There is no authentication and there must never
#    need to be one: the socket IS the boundary, and it returns this fleet's
#    private knowledge to whoever connects.
# 🛑 FOUR SOCKETS, AND THE COUNT IS A CONTRACT WITH THE DAEMON (2026-09-19).
#    `http.listeners` defaults to 4 (`DEFAULT_LISTENERS`, src/declared-paths-pure.js)
#    and the daemon REFUSES TO START when the number systemd hands it differs from
#    the number the configuration declares — deliberately: serving fewer would drop
#    that share of EVERY action, in silence, with nothing going red. So these lines
#    and that constant are ONE fact in two files, and `service-units-gate` is what
#    keeps them equal.
# 📐 sd_listen_fds(3) hands the descriptors "in the order of configuration", and the
#    daemon maps them onto 3, 4, 5, 6 — so the order decides which PORT arrives on
#    which descriptor.
# ⚠️ AND THAT IS DELIBERATELY NOT LOAD-BEARING — an earlier version of this comment
#    claimed it was, on 2026-09-19, and that was a FALSE INVARIANT. Every socket is
#    served by the SAME handler sharing ONE sequencer table, so which port a frame
#    lands on changes nothing about what it is served. A claimed invariant nobody
#    can violate is worse than none: it makes the next reader protect the wrong
#    thing. What IS load-bearing is the COUNT, stated just above.
# ⚠️ Whoever wants the pre-2026-09-19 behaviour keeps ONE line here and writes
#    `"listeners": 1` in the configuration — both sides, or neither.
ListenStream=127.0.0.1:8787
ListenStream=127.0.0.1:8788
ListenStream=127.0.0.1:8789
ListenStream=127.0.0.1:8790

# ⚠️ DECLARED, NEVER LEFT TO SYSTEMD'S OWN DEFAULT (2026-09-17) — same
#    principle as `LISTEN_BACKLOG` in `http-server.js`: a capacity this
#    project relies on is written, not inherited. Under socket activation
#    THIS unit binds the socket, not the daemon, so `http-server.js`'s own
#    constant does not apply here — this line is the one that actually
#    governs the Linux accept queue.
# 📐 systemd.socket(5): modern systemd defaults `Backlog=` to its own
#    maximum (4294967295), itself silently capped by the kernel's
#    `net.core.somaxconn` — but OLDER systemd defaulted to plain `SOMAXCONN`
#    (128), a ceiling low enough to reproduce the exact burst-refusal class
#    this project spent 2026-09-16/17 diagnosing on Windows. Declaring it
#    explicitly removes that version-dependent gap. `man7.org/linux/man-
#    pages/man5/systemd.socket.5.html`.
# 🛑 The REAL ceiling still needs `net.core.somaxconn` raised at the OS
#    level (root, `sysctl`) if the kernel default (4096 on 5.4+, 128
#    before) is ever the true bottleneck — no unit file, no application
#    code, can force a number past what the kernel itself is configured to
#    grant. Out of scope for this file; an installer-level step, not yet
#    added (`install-linux.sh` does not touch sysctl as of this date).
Backlog=65535

# ═══════════════════════════════════════════════════════════════════════
# 🛑 Accept=no — THE ONE SETTING THAT WOULD UNDO THE ENTIRE HTTP LANE
# ═══════════════════════════════════════════════════════════════════════
# 📐 systemd.socket(5), verbatim: "If yes, a service instance is spawned for each
#    incoming connection and only the connection socket is passed to it. If no,
#    all listening sockets themselves are passed to the started service unit, and
#    only one service unit is spawned for all connections."
# ⇒ `Accept=yes` is the inetd model: ONE PROCESS PER CONNECTION. This lane exists
#    precisely to delete the ~330 ms of node startup that the spawn lane pays per
#    frame — with `Accept=yes` we would pay it again, per frame, with a
#    supervisor added on top. The same manual says as much: for performance-
#    sensitive services `Accept=no` is preferable "since only the initial
#    connection incurs activation costs".
# ⚠️ It is ALSO where duplicate prevention now lives: "only one service unit is
#    spawned for all connections". On the port path the kernel refused a second
#    instance with EADDRINUSE; here systemd does. It is still the OS — never a
#    PID file, never an "is it already running?" test.
# 🛑 `no` is already the default. It is WRITTEN because this file depends on it,
#    and because a reader who flips it would silently reintroduce the exact cost
#    the lane was built to remove.
Accept=no

# ═══════════════════════════════════════════════════════════════════════
# THE TRIGGER RATE — raised, and the reason is our own wiring
# ═══════════════════════════════════════════════════════════════════════
# 📐 systemd.socket(5): the interval defaults to 2 s and the burst to "200 for
#    Accept=yes sockets, 20 otherwise", and — this is the part that decides the
#    values below — "If the limit is hit, the socket unit is placed into a
#    failure mode, and will not be connectible anymore until restarted."
# 🔴 THAT FAILURE IS TOTAL AND MANUAL: the socket stops accepting, so the whole
#    fleet loses the lane until a human restarts it. Exactly the state this file
#    exists to make unreachable.
# ⚠️ THE STOCK 20 IS REACHABLE BY DESIGN, not by pathology: an action declares 16
#    frames, i.e. up to 16 connections. If the daemon stands down between them —
#    which is precisely what a `git pull` makes it do — each one activates. One
#    ordinary action would sit at 16 of the 20 allowed.
# ⚠️ 200 is not invented either: it is systemd's own burst for the other Accept=
#    mode, and 10 s spans several actions. A limit is kept (a genuinely broken
#    build must fail LOUDLY rather than spin forever), only moved past the
#    legitimate burst.
TriggerLimitIntervalSec=10s
TriggerLimitBurst=200

# 🛑 FlushPending= IS DELIBERATELY ABSENT, AND IT IS THE MOST DANGEROUS KEY THIS
#    FILE COULD CARRY. systemd.socket(5): "May only be used when Accept=no. If
#    yes, the socket's buffers are cleared after the triggered service exited"
#    — which drops the connections waiting in the backlog. Those queued
#    connections ARE the repair: they are the injections that survive a
#    stale-code exit. Setting it to yes would restore the silent outage while
#    the unit still looked perfectly configured. Never add it.

[Install]
# ⚠️ THE SOCKET IS WHAT GETS ENABLED — the service must NOT be, which is why it
#    carries no [Install] section any more. Enabling the service would start the
#    daemon eagerly at login and defeat on-demand activation.
# ⚠️ `sockets.target` is the user manager's own target for socket units, the
#    counterpart of the `default.target` the service used to be wanted by.
WantedBy=sockets.target
